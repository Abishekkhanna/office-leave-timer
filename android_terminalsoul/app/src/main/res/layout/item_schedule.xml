<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#151A24"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Status Dot -->
        <TextView
            android:id="@+id/txt_status_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢"
            android:textSize="14sp"
            android:layout_marginEnd="10dp" />

        <!-- Time & Category -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txt_schedule_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00 AM"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/txt_category_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️ MORNING"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#1E293B"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_next_trigger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next: Today at 09:00 AM"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <!-- Toggle Switch / Button -->
        <Button
            android:id="@+id/btn_toggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="60dp"
            android:text="ACTIVE"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#059669"
            android:stateListAnimator="@null"
            android:layout_marginEnd="6dp" />

        <!-- Edit Button -->
        <Button
            android:id="@+id/btn_edit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✎"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:background="#1E2430"
            android:stateListAnimator="@null"
            android:layout_marginEnd="4dp" />

        <!-- Delete Button -->
        <Button
            android:id="@+id/btn_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✕"
            android:textColor="#EF4444"
            android:textSize="14sp"
            android:background="#1E2430"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>
